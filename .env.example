AIOSELL_BASE_URL="https://live.aiosell.com/api/v2/cm"
AIOSELL_USERNAME="aiosell"
AIOSELL_PASSWORD="AIOsell@123"
AIOSELL_HOTEL_CODE="sandbox-pms"
AIOSELL_PARTNER_ID="sample-pms"
